{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:allow-load",
    "sql:allow-close",
    "sql:allow-execute",
    "sql:allow-select",
    "fs:default",
    "fs:allow-app-write",
    "fs:allow-app-read",
    "fs:scope-app-recursive",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-read-dir",
    "dialog:allow-open",
    "dialog:allow-save",
    "notification:default"
  ]
}